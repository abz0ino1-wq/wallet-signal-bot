# --- Ethereum mainnet RPC (Alchemy recommended: WS needed for mempool + live logs) ---
ALCHEMY_API_KEY=
# Optional: override if you use a different provider with an Alchemy-compatible WS/HTTP endpoint
ALCHEMY_WS_URL=
ALCHEMY_HTTP_URL=

# --- Etherscan API (used for wallet trade-history based profitability scoring) ---
# Etherscan's v2 API key works across chains: https://etherscan.io/apis
ETHERSCAN_API_KEY=

# --- Moralis API (optional but recommended: server-computed, USD-denominated ---
# wallet PnL and per-token top-trader lookups, instead of the local heuristic
# built from raw Etherscan calldata). Free tier available: https://moralis.io
# Leave blank to run on the Etherscan-only heuristic instead.
MORALIS_API_KEY=

# --- Telegram bot (create via @BotFather, then message your bot once and fetch chat id) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Storage ---
DB_PATH=./data/wallet-signal-bot.sqlite

# --- Signal thresholds (all optional, sensible defaults in src/config.ts) ---
MAX_MARKET_CAP_USD=1000000
MIN_LIQUIDITY_USD=5000
MIN_SAFETY_SCORE=60
MIN_WALLET_SCORE=60
# Lower liquidity bar for the "fresh pair" signal (brand-new pairs won't have
# an established token's liquidity yet)
MIN_FRESH_PAIR_LIQUIDITY_USD=2000
# How long to wait after a new pair is created before checking it (lets
# Dexscreener catch up indexing the pool)
FRESH_PAIR_CHECK_DELAY_MS=15000

# --- Wallet discovery ---
# Minimum multiple (e.g. 3 = 3x) a token must have pumped for its early buyers to be considered candidates
DISCOVERY_MIN_PUMP_MULTIPLE=3
# How many candidate tokens to scan per discovery run
DISCOVERY_TOKEN_SAMPLE_SIZE=25
