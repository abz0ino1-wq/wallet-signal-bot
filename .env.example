# --- Robinhood Chain RPC (chainId 4663) ---
# Alchemy officially supports this chain. Get a key at alchemy.com, create an
# app for "Robinhood Chain", and check the exact WS/HTTP URLs it gives you --
# if they differ from the guessed "robinhood-mainnet.g.alchemy.com" pattern
# below, set the overrides explicitly.
ALCHEMY_API_KEY=
ALCHEMY_WS_URL=
ALCHEMY_HTTP_URL=

# --- Blockscout API (Robinhood Chain's block explorer, free + keyless) ---
# Leave blank to use the default: https://robinhoodchain.blockscout.com/api
BLOCKSCOUT_API_URL=

# --- ScanHood (honeypot/rug safety check -- GoPlus doesn't cover this chain) ---
# Free, no key needed. Leave blank to use the default: https://scanhood.xyz
# (confirmed against https://scanhood.xyz/llms.txt -- their own agent-facing
# API docs). If it ever breaks, check that page again for changes.
SCANHOOD_API_URL=

# --- Telegram bot (create via @BotFather, then message your bot once and fetch chat id) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Storage ---
DB_PATH=./data/wallet-signal-bot.sqlite

# --- Optional: skip the on-chain WETH() lookup at startup if you already
# know the wrapped-ETH address for this chain ---
WETH_ADDRESS=

# --- Signal thresholds (all optional, sensible defaults in src/config.ts) ---
# "Dex paid" hot-token market-cap band -- tight on purpose, catches tokens
# while they're still genuinely small.
MIN_MARKET_CAP_USD=3000
MAX_MARKET_CAP_USD=10000
MIN_LIQUIDITY_USD=5000
# Minimum 24h volume (USD) -- filters out quiet pools that happen to sit in
# the market-cap band with no real trading behind them.
MIN_VOLUME_USD=1000
# Max token age (hours) for the "dex paid" signal -- a token can launch,
# sit for hours/days, then start paying for a boost. This keeps that signal
# about genuinely fresh tokens, not just currently-boosted ones.
MAX_TOKEN_AGE_HOURS=6
MIN_SAFETY_SCORE=60
MIN_WALLET_SCORE=60
# Lower liquidity bar for the "fresh pair" signal (brand-new pairs won't have
# an established token's liquidity yet)
MIN_FRESH_PAIR_LIQUIDITY_USD=2000
# How long to wait after a new pair is created before checking it (lets
# Dexscreener catch up indexing the pool)
FRESH_PAIR_CHECK_DELAY_MS=15000

# --- Wallet discovery ---
# Minimum multiple (e.g. 3 = 3x) a token must have pumped for its early buyers to be considered candidates
DISCOVERY_MIN_PUMP_MULTIPLE=3
# How many candidate tokens to scan per discovery run
DISCOVERY_TOKEN_SAMPLE_SIZE=25
